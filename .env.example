# Copy to .env and provide your own secrets. Do not commit .env.
POSTGRES_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
DEFAULT_TENANT_ID=demo-factory
DEMO_MODE=1
DEMO_INSPECTOR_PASSWORD=
DEMO_ENGINEER_PASSWORD=
DEMO_MANAGER_PASSWORD=
DEMO_ADMIN_PASSWORD=
DEMO_AUDITOR_PASSWORD=
AGENT_MODE=mock
# Visual detector is independent of the LLM. Keep mock until a service is validated.
# For the bundled Anomalib service: start `docker compose --profile detector up`,
# train/calibrate first (detector/train_patchcore.py), then set:
#   DETECTOR_MODE=http
#   DETECTOR_URL=http://detector:8080/inspect
#   DETECTOR_PROFILES_PATH=data/detector_profiles.json
DETECTOR_MODE=mock
DETECTOR_URL=
DETECTOR_PROFILES_PATH=data/detector_profiles.example.json
# Shared by API/worker (outbound Bearer token) and the detector service.
DETECTOR_API_KEY=
DETECTOR_DEVICE=cpu
DETECTOR_STUB=0
LLM_PROVIDER=anthropic
LLM_BASE_URL=https://api.deepseek.com/anthropic
LLM_MODEL=deepseek-flash
LLM_API_KEY=

# Optional native DeepSeek Harness inspection brief settings.
# When LLM_BASE_URL is the official Anthropic endpoint, DSH can reuse LLM_API_KEY.
DSH_INSPECTION_API_KEY=
DSH_INSPECTION_MODEL=deepseek-v4-flash

